{
  "name": "mova-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Mova — motion intelligence for rehabilitation. Light narrative landing + clinician console.",
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "predev": "node scripts/sync-content.mjs && node scripts/fetch-models.mjs",
    "prebuild": "node scripts/sync-content.mjs && node scripts/fetch-models.mjs",
    "dev": "next start",
    "build": "next build",
