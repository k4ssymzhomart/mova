# Mova frontend — environment.
# Real Google + email sign-in (Supabase Auth, provisioned in Phase 1). Without these the app runs in
# guest mode so the product is still usable locally.
#
# Get the URL + anon key from your Supabase project (Settings → API), or run a local stack with
# `supabase start` (uses http://localhost:54321 + the printed anon key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
#
# Then, in Supabase → Authentication → Providers, enable Google (add your Google OAuth client id/secret)
# and add your app origin's /session path to the allowed redirect URLs.
