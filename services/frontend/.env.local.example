# Mova frontend — environment.
# Real Google + email sign-in (Supabase Auth, provisioned in Phase 1). Without these the app runs in
# guest mode so the product is still usable locally.
#
# Get the URL + anon key from your Supabase project (Settings → API), or run a local stack with
# `supabase start` (uses http://localhost:54321 + the printed anon key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
#
# Then, in Supabase → Authentication → Providers, enable Google (add your Google OAuth client id/secret)
# and add your app origin's /auth/callback path to the allowed redirect URLs.
#
# Server-only key for the clinician portal's aggregate reads. Bypasses RLS — never NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
#
# The deployment's own public origin. Behind a proxy (Vercel, Render) a route handler sees the internal
# bind host, so auth callbacks need this to redirect to the address the browser actually used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Live FoG inference backend (services/api). Set ONE — unset runs a clearly-labelled simulated readout.
#   HTTP: serverless hosts (Vercel). Each window is POSTed to `${…}/api/v1/predict/fog`. Wins if both set.
# NEXT_PUBLIC_BACKEND_HTTP_URL=https://mova-api-seven.vercel.app
#   WS: long-lived hosts (Docker/uvicorn). Streams over `${…}/api/v1/predict/fog/stream`.
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000
