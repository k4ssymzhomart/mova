# ── Secrets / credentials (NEVER commit — VPN/SSH passwords, keys, tokens) ──
.env
.env.*
!.env.example
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa
id_ed25519
*_rsa
*_ed25519
.netrc
secrets/
**/secrets/
.secrets/
*secret*
*credential*
*.token

# ── Data (versioned via DVC remote, never committed to git) ────────────────
/data/raw/*
/data/interim/*
/data/processed/*
/data/synthetic/*
!/data/raw/.gitkeep
!/data/interim/.gitkeep
!/data/processed/.gitkeep
!/data/synthetic/.gitkeep
# keep DVC pointer files + DVC-managed ignores (so data is reproducible from git)
!/data/raw/*.dvc
!/data/raw/.gitignore
# keep the small, checked-in metadata
!/data_manifests/

# ── ML artifacts / experiment outputs ──────────────────────────────────────
checkpoints/
outputs/
multirun/
.hydra/
lightning_logs/
wandb/
mlruns/
*.ckpt
*.pt
*.pth
*.onnx
*.engine
*.plan

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.venv312/
.venv-sqlcheck/
venv/
.env
.env.*
!.env.example
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# ── DVC ────────────────────────────────────────────────────────────────────
/.dvc/cache
/.dvc/tmp
/.dvc/config.local

# ── Frontend / Node ────────────────────────────────────────────────────────
node_modules/
services/frontend/.next/
services/frontend/dist/
services/frontend/.turbo/
*.tsbuildinfo

# MediaPipe Pose runtime assets. scripts/fetch-models.mjs copies the wasm out of node_modules and
# downloads the .task on prebuild, so these are build outputs (~39 MB), never sources. See
# services/frontend/public/models/README.md.
services/frontend/public/mediapipe/

# ── Supabase CLI local state ───────────────────────────────────────────────
supabase/.branches/
supabase/.temp/

# ── OS / IDE ───────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.log

# Vercel CLI link/state
.vercel

CLAUDE.md
# Claude Code session config for this worktree — not part of the change.
.claude/
