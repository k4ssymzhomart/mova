# Copy to `.env` (gitignored) and fill in. NEVER commit the real .env.
# Deployment target (used by scripts/deploy_to_gpu.sh). Prefer the `mova-gpu` SSH alias instead.
MOVA_GPU_HOST=mova-gpu
MOVA_GPU_DIR=mova

# Weights & Biases (training telemetry) — set on the GPU box, not in git.
# WANDB_API_KEY=

# ── Supabase backend (Phase 1) ─────────────────────────────────────────────
# OAuth provider secrets read by supabase/config.toml via env(...). Email + TOTP
# MFA need none of these locally. Leave unset unless testing social sign-in.
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
# SUPABASE_AUTH_APPLE_CLIENT_ID=
# SUPABASE_AUTH_APPLE_SECRET=
# SUPABASE_AUTH_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_GITHUB_SECRET=

# Shared HMAC secret for the Supabase <-> Python inference contract (contracts/inference).
# In production this lives in the Supabase Vault + the service env, never in git.
# MOVA_INFERENCE_SIGNING_SECRET=
