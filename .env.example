# Copy to `.env` (gitignored) and fill in. NEVER commit the real .env.
# Deployment target (used by scripts/deploy_to_gpu.sh). Prefer the `mova-gpu` SSH alias instead.
MOVA_GPU_HOST=mova-gpu
MOVA_GPU_DIR=mova

# Weights & Biases (training telemetry) — set on the GPU box, not in git.
# WANDB_API_KEY=

# ── Supabase backend (Phase 1) ─────────────────────────────────────────────
# OAuth provider secrets read by supabase/config.toml via env(...). Email + TOTP
# MFA need none of these locally. Leave unset unless testing social sign-in.
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
# SUPABASE_AUTH_APPLE_CLIENT_ID=
# SUPABASE_AUTH_APPLE_SECRET=
# SUPABASE_AUTH_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_GITHUB_SECRET=

# Shared HMAC secret for the Supabase <-> Python inference contract (contracts/inference).
# In production this lives in the Supabase Vault + the service env, never in git.
# MOVA_INFERENCE_SIGNING_SECRET=

# ── Frontend <-> Supabase (services/frontend/.env.local; gitignored) ───────────
# The web app reads these. Copy into services/frontend/.env.local and fill in from
# the Supabase dashboard (Project Settings > API). NEXT_PUBLIC_* are safe in the
# browser; the service-role key is SERVER-ONLY and must never be exposed client-side.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key — server only>
#
# Public origin of the deployment, used for OAuth redirects behind a proxy.
# NEXT_PUBLIC_SITE_URL=https://<your-app-host>
#
# Live inference backend (services/api). Set ONE; unset => simulated fallback.
#   HTTP — serverless hosts (Vercel). POSTs each window to `${…}/api/v1/predict/fog`. Wins if both set.
# NEXT_PUBLIC_BACKEND_HTTP_URL=https://<your-api-host>
#   WS — long-lived hosts (Docker/uvicorn). Streams to `${…}/api/v1/predict/fog/stream`.
# NEXT_PUBLIC_BACKEND_WS_URL=wss://<your-api-host>
